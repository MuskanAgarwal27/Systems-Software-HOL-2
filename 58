#include <stdio.h>
#include <pthread.h>
void *work(void *arg)
{
    printf("Thread %d running, its ID is %lu\n", *(int *)arg, pthread_self());
    return NULL;
}
int main(void)
{
    pthread_t tid[3];
    int num[3] = {1, 2, 3};
    for (int i = 0; i < 3; i++)
        pthread_create(&tid[i], NULL, work, &num[i]);
    for (int i = 0; i < 3; i++) {
        pthread_join(tid[i], NULL);
        printf("Main: created thread %d had ID %lu\n", num[i], tid[i]);
    }
    return 0;
}
